{
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/cursos", "destination": "/cursos.html" },
    { "source": "/contato", "destination": "/contato.html" },
    { "source": "/curso/:slug", "destination": "/curso.html?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
